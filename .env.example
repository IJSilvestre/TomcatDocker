# Variaveis do docker-compose.yml e do restore-db.sh.
# Modelo versionado. Copie para .env e ajuste as senhas:  cp .env.example .env

# --- PostgreSQL ---
POSTGRES_VERSION=12-alpine
POSTGRES_DB=solocria
POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# --- Tomcat ---
# Troque para 9.0-jdk8-temurin se a aplicacao exigir Java 8
TOMCAT_VERSION=9.0-jdk11-temurin
PG_JDBC_VERSION=42.7.4
TOMCAT_PORT=8080
JAVA_XMS=256m
JAVA_XMX=1024m

# --- pgAdmin ---
PGADMIN_VERSION=latest
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# --- Geral ---
TZ=America/Sao_Paulo
